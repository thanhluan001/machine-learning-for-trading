# Copy to .env and fill in your own keys. Never commit the real .env.

# Tiingo — daily EOD prices (https://www.tiingo.com/)
TIINGO_API_KEY=

# Financial Modeling Prep — earnings calendar/actuals, analyst grades
# (https://site.financialmodelingprep.com/) — Starter tier or better
FMP_API_KEY=

# FRED — macro series (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Alpaca PAPER trading (https://alpaca.markets/) — paper keys only
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
